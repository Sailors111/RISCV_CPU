TD_tb_top.print_final_state ;
    %vpi_call 2 112 "$display", "============================================================" {0 0 0};
    %vpi_call 2 113 "$display", "FINAL REGISTER STATE" {0 0 0};
    %vpi_call 2 114 "$display", "x1 =%08h x2 =%08h x3 =%08h x4 =%08h", &A<v0x6409864f8af0, 1>, &A<v0x6409864f8af0, 2>, &A<v0x6409864f8af0, 3>, &A<v0x6409864f8af0, 4> {0 0 0};
    %vpi_call 2 119 "$display", "x5 =%08h x6 =%08h x7 =%08h x8 =%08h", &A<v0x6409864f8af0, 5>, &A<v0x6409864f8af0, 6>, &A<v0x6409864f8af0, 7>, &A<v0x6409864f8af0, 8> {0 0 0};
    %vpi_call 2 124 "$display", "x9 =%08h x10=%08h x11=%08h x12=%08h", &A<v0x6409864f8af0, 9>, &A<v0x6409864f8af0, 10>, &A<v0x6409864f8af0, 11>, &A<v0x6409864f8af0, 12> {0 0 0};
    %vpi_call 2 129 "$display", "FINAL MEMORY STATE" {0 0 0};
    %vpi_call 2 130 "$display", "mem[0]=%08h mem[1]=%08h mem[2]=%08h mem[3]=%08h", &A<v0x640986500be0, 0>, &A<v0x640986500be0, 1>, &A<v0x640986500be0, 2>, &A<v0x640986500be0, 3> {0 0 0};
    %vpi_call 2 135 "$display", "============================================================" {0 0 0};
    %end;
